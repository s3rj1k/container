# Monolithic arm64 kernel for Apple Containerization. No modules, virtio only.
# Curated config, expand it with
#   make ARCH=arm64 olddefconfig


# Security and hardening
# MODULES off, KASLR fortify and freelist hardening on, init_on_alloc opt in
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity"
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_HARDENED_USERCOPY=y
# CONFIG_MODULES is not set
CONFIG_RANDOMIZE_BASE=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_HARDENED=y

# Virtualization for nested guests
# KVM vhost vDPA and VFIO
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VIRTIO_VDPA=y
CONFIG_VDPA=y
CONFIG_IFCVF=y
CONFIG_VP_VDPA=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VHOST_VDPA=y

# Netfilter nftables iptables ipset and IPVS
